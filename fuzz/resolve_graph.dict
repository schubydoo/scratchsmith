# libFuzzer dictionary for resolve_graph: the ld.so search tokens the resolver expands or matches.
# Seeding them lets the engine reach the RPATH/RUNPATH/$ORIGIN and soname branches directly
# instead of discovering the literal strings byte-by-byte.
"$ORIGIN"
"${ORIGIN}"
"$LIB"
"${LIB}"
"$PLATFORM"
"${PLATFORM}"
"/lib64"
"/usr/lib"
"lib/x86_64-linux-gnu"
".so"
"ld-linux-x86-64.so.2"
"ld-musl-x86_64.so.1"
# The harness's own loader file. A DT_NEEDED entry that names it makes the walk reach the
# loader as a library too. With shared-object facts from `interp_core`, it resolves and is
# queued. With no facts, the corrupt loader fails at PT_INTERP first, whether or not a library
# lists it. `exists()` gives the engine no byte-by-byte feedback on a path, so without these
# literals that shape stays unreached.
"ld-fuzz.so.2"
"/lib64/ld-fuzz.so.2"
# RPATH and RUNPATH strings are ':' lists. An empty entry is a leading, trailing or doubled ':'.
":"
"::"
":$ORIGIN"
"$ORIGIN:"
"$ORIGIN/libs"
"/opt/none:"
