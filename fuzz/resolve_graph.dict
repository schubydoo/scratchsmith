# libFuzzer dictionary for resolve_graph: the ld.so search tokens the resolver expands or matches.
# Seeding them lets the engine reach the RPATH/RUNPATH/$ORIGIN and soname branches directly
# instead of discovering the literal strings byte-by-byte.
"$ORIGIN"
"${ORIGIN}"
"$LIB"
"${LIB}"
"$PLATFORM"
"${PLATFORM}"
"/lib64"
"/usr/lib"
"lib/x86_64-linux-gnu"
".so"
"ld-linux-x86-64.so.2"
"ld-musl-x86_64.so.1"
# The harness's own loader file. It carries the ELF magic and has no scripted facts, so a
# DT_NEEDED entry that names it is the one way to reach the "starts like an ELF and cannot be
# parsed" warning arm in `resolve_with`. `exists()` gives the engine no byte-by-byte feedback
# on a path, so without these literals that arm stays unreached.
"ld-fuzz.so.2"
"/lib64/ld-fuzz.so.2"
